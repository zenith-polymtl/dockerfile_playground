      },
      {
        "text": "ARM & AUTHORIZE TAKEOFF",
        "class": "arm-btn",
        "command": "confirm_arming"
      }
    ]
  },
  "control_sections": [
    {
      "title": "Vision Control",
      "buttons": [
        {
          "text": "Source Search",
          "command": "vision_source"
        },
        {
          "text": "Bucket Search",
          "command": "vision_bucket"
        }
      ]
    },
    {
      "title": "Approach Mode",
      "buttons": [
        {
          "text": "Manual Mode",
          "command": "manual_approach"
        },
        {
          "text": "Auto Mode",
          "command": "auto_approach"
        }
      ]
    },
    {
      "title": "Winch Control",
      "buttons": [
        {
          "text": "Winch Down",
          "command": "winch_down"
        },
        {
          "text": "Winch Up",
          "command": "winch_up"
        }
      ]
    },
    {
      "title": "Water System",
      "buttons": [
        {
          "text": "Refill Water",
          "command": "water_refill"
        },
        {
          "text": "Release Water",
          "command": "water_release"
        },
        {
          "text": "Open Valve",
          "command": "valve_open"
        },
        {
          "text": "Close Valve",
          "command": "valve_close"
        }
      ],
      "inputs": [
        {
          "type": "number",
          "id": "bucketNumber",
          "command": "set_buckets",
          "min": "1",
          "value": "1",
          "label": "Buckets:"
        }
      ]
    },
    {
      "title": "Sensor Data",
      "sensors": [
        {
          "id": "waterQty",
          "label": "Water Quantity",
          "value": "0 mL"
        },
        {
          "id": "torque",
          "label": "Motor Torque",
          "value": "0.00 Nm"
        }
      ]
    }
  ]
}